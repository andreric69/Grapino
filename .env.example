# Supabase-Projekt-Zugangsdaten (aus Supabase Dashboard -> Project Settings -> API)
# NIEMALS den "service_role"-Key hier eintragen - nur den "anon"/"public"-Key!
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NUR fuer api/recognize-label.ts (serverseitig) - OHNE VITE_-Praefix, damit
# der Key nie ins Client-Bundle gelangt. Aus console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dasselbe Secret wie PUSH_WEBHOOK_SECRET im Vercel-Projekt "grapino-admin" -
# api/_errorLog.ts nutzt es, um unerwartete Fehler aus stripe-webhook.ts/
# create-checkout-session.ts/create-payment-checkout-session.ts/
# recognize-label.ts als Push-Benachrichtigung an Andrin zu melden (ruft
# api/push?resource=notify-error der Admin-App auf, siehe dort). Ohne diese
# Variable wird nur noch in admin_error_log geloggt, aber keine Push-
# Benachrichtigung ausgeloest - kein Absturzrisiko, nur stille Degradierung.
PUSH_WEBHOOK_SECRET=
